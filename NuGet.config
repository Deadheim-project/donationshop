<?xml version="1.0" encoding="utf-8"?>
<!-- Isola o restore das fontes de nivel de maquina (a fonte offline do Visual Studio
     nao existe nesta maquina e derrubava o restore com NU1301). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
